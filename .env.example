# SYRIX Folio reads credentials from (in order): the system environment,
# its own .env in the app data folder, then an optional shared .env whose path is set in Settings.
# All services below have free tiers; Folio never uses paid models.
GROQ_API_KEY=
OPENROUTER_API_KEY=
NEWS_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
